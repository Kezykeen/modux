# Server
NODE_ENV=development
PORT=3001

# Neon Lakebase Postgres — run `npx neon@latest env pull --file server/.env` after `neon link`
# Use DATABASE_URL (pooled) at runtime; DATABASE_URL_UNPOOLED for `npm run db:migrate`
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth secret (min 32 chars) — generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public API base URL (where this server runs)
BETTER_AUTH_URL=http://localhost:3001

# Allowed frontend origins, comma-separated (CORS + Better Auth trustedOrigins)
CLIENT_ORIGIN=http://localhost:5173
# Production example:
# CLIENT_ORIGIN=https://modu-x.vercel.app,http://localhost:5173

# Neon Object Storage — `neon env pull` writes AWS_*; app maps them to S3_* in env.ts
STORAGE_DRIVER=s3
S3_BUCKET=modux
# Or set explicitly: S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_ENDPOINT
# ASSETS_PUBLIC_URL=   # optional CDN; default serves via /api/assets

# Local dev fallback (docker compose up -d in server/)
# STORAGE_DRIVER=local
# LOCAL_STORAGE_PATH=./data/uploads
